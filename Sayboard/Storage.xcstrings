    "Models include files still downloading or awaiting cleanup. Expand a row to inspect its files.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Models include files still downloading or awaiting cleanup. Expand a row to inspect its files."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelle enthalten auch laufende Downloads und Dateien, die noch bereinigt werden. Klappe eine Zeile auf, um ihre Dateien anzuzeigen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "模型項目包括下載中的檔案及待清理資料。展開項目可查看檔案。"
          }
        }
      }
    },
    "Showing the largest files. Total includes all measured files.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
