    "Includes the app installation and shared keyboard files. System-managed storage outside the app is excluded. Totals may differ from iOS Settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Includes the app installation and shared keyboard files. System-managed storage outside the app is excluded. Totals may differ from iOS Settings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Enthält die App-Installation und gemeinsame Tastaturdateien. Vom System verwalteter Speicher außerhalb der App ist nicht enthalten. Die Summe kann von den iOS-Einstellungen abweichen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "包括 App 本體及鍵盤共用檔案；不包括 App 以外由系統管理的空間。總數可能與 iOS 設定不同。"
          }
        }
      }
    }
