      }
    },
    "Some file sizes are estimates because allocated space was unavailable.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some file sizes are estimates because allocated space was unavailable."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Dateigrößen sind Schätzwerte, da der belegte Speicher nicht ermittelt werden konnte."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "部分檔案無法讀取實際佔用空間，改用檔案大小估算。"
          }
        }
      }
    },
